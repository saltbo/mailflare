# Realmroot confidential web application. Never commit the client secret.
APP_URL=https://mail.tftt.cc
OIDC_ISSUER=https://id.realmroot.dev/api/auth
OIDC_CLIENT_ID=replace-with-client-id
OIDC_CLIENT_SECRET=replace-with-client-secret
# Comma-separated immutable Realmroot subjects permitted to configure infrastructure.
OIDC_OPERATOR_SUBJECTS=replace-with-operator-subject
MAILBOX_DOMAIN=tftt.cc
# Runtime Cloudflare token for DNS and Email Routing. Not the deployment token.
CF_TOKEN=replace-with-runtime-token
